# ---------------------------------------------------------------------------
# Zwep environment
#
# Copy to .env and adjust. Everything has a working development default, so an
# empty .env still boots. Values already set in the real environment win over
# this file, which is what CI and container deployments expect.
#
# Before exposing Zwep beyond localhost, read SECURITY.md — at minimum, change
# ZWEP_ADMIN_KEY and MEILI_MASTER_KEY.
# ---------------------------------------------------------------------------

# --- Search index ----------------------------------------------------------
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=zwep_dev_master_key_change_me
MEILI_INDEX=zwep_documents

# --- Queue (reserved; the crawler currently runs inline) -------------------
REDIS_URL=redis://127.0.0.1:6379

# --- API -------------------------------------------------------------------
API_PORT=8080
# Loopback by default. Only widen this if a reverse proxy terminates TLS
# in front of the API.
API_HOST=127.0.0.1
# Comma-separated allowed origins, or "*" for development.
API_CORS_ORIGINS=*
# Requests per minute per client IP. Set to 0 to disable.
API_RATE_LIMIT=120
# Required by every mutating endpoint. Sent as the x-admin-key header.
ZWEP_ADMIN_KEY=zwep_admin_dev_key

# --- Crawler ---------------------------------------------------------------
CRAWLER_USER_AGENT=ZwepBot/1.0 (+https://github.com/philppplik/zwep)
CRAWLER_CONCURRENCY=4
# Minimum delay between requests to the same host, in milliseconds. A larger
# crawl-delay in robots.txt always wins.
CRAWLER_DELAY_MS=500
CRAWLER_TIMEOUT_MS=20000
# Maximum bytes buffered from a single response (5 MB).
CRAWLER_MAX_BYTES=5000000

# --- Storage ---------------------------------------------------------------
# Where sources.json and the SQLite databases live. Defaults to ./data.
ZWEP_DATA_DIR=
# Explicit path for the knowledge graph database. Defaults to <data>/graph.db.
GRAPH_DB=

# --- Google proxy (privacy: opt-in) ----------------------------------------
# When false, google-type sources are rejected. Enable only if you want Zwep to
# send your configured queries to Google on your behalf.
# Accepts true/false, 1/0, yes/no, on/off.
GOOGLE_PROXY_ENABLED=false

# --- Semantic search (optional) --------------------------------------------
# none | ollama | openrouter
EMBED_PROVIDER=none
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# --- AI Overview (optional) ------------------------------------------------
# none | ollama | openrouter
# "ollama" keeps everything local. "openrouter" sends queries and result
# excerpts to a third party.
LLM_PROVIDER=none
OLLAMA_LLM_MODEL=llama3.1
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_LLM_KEY=
# How long a generated overview stays cached. 0 disables caching.
OVERVIEW_TTL_HOURS=168
